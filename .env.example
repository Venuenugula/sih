# INDUSAI environment template
# Copy this file to .env and fill in values.
# Never commit real API keys or passwords.

# --- App ---
APP_NAME=INDUSAI
APP_MODE=prototype

# Banner shown in the UI. Do not change this for the demo.
AI_INFERENCE_LABEL=External AI Inference — Prototype Mode

# --- External multimodal LLM (NOT on-premises) ---
# Used only for the current question, with selected evidence.
# Future work: replace this with a locally hosted open-weight model.
#
# Google Gemini (OpenAI-compatible):
# LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-2.5-flash
# VISION_MODEL=gemini-2.5-flash
LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=replace-with-your-key
LLM_MODEL=gemini-2.5-flash
VISION_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=60

# --- Local embeddings (runs on this machine) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Storage paths ---
CHROMA_PATH=./chroma_db
SQLITE_PATH=./data/indusai.sqlite
DATA_DIR=./data

# --- RAG ---
RAG_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Demo login (synthetic users only; passwords hashed into SQLite) ---
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=demo123
DEMO_ENGINEER_USERNAME=engineer
DEMO_ENGINEER_PASSWORD=demo123
DEMO_REVIEWER_USERNAME=reviewer
DEMO_REVIEWER_PASSWORD=demo123
